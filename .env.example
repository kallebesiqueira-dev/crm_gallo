# Copy this file to `.env` (gitignored) and fill in real values.
# NEVER commit a `.env` with real secrets.

# ---- Runtime ----
# `production` enforces strict secret validation at startup.
ENVIRONMENT=development

# ---- Backend DB ----
# Owner role (`crm`) for Alembic migrations (DDL bypasses RLS).
DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm
SYNC_DATABASE_URL=postgresql://crm:crm@db:5432/crm
# Runtime role (`crm_app`, NOSUPERUSER NOBYPASSRLS) created by
# migration f5fde59e0dc8 — used by the FastAPI process so RLS
# policies actually enforce (Phase 6 defense-in-depth). When
# unset, falls back to DATABASE_URL (single-role mode = RLS off).
APP_DATABASE_URL=postgresql+asyncpg://crm_app:crm_app_dev_2026@db:5432/crm
REDIS_URL=redis://redis:6379/0

# JWT — generate with: openssl rand -hex 48
# Must be at least 32 characters. Startup refuses defaults in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — port the BROWSER uses (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3030
# Cookie Domain for auth cookies. Set to a shared parent (e.g. ".gallo-crm.com")
# when the frontend (app.) and API (api.) are on DIFFERENT subdomains, so the
# SPA can read the csrf cookie. Empty = host-only (same-origin / local dev).
COOKIE_DOMAIN=

# Rate limits (requests per minute per IP)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3

# ---- S3-compatible storage (FileAttachments) ----
# Defaults match the MinIO sidecar in docker-compose. Swap to AWS S3
# / R2 / etc. in prod by changing the endpoint URL + rotating creds.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=crm-gallo-attachments
S3_REGION=us-east-1

# ---- Sentry (empty = SDK no-op, no overhead) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- LLM provider ----
# "ollama" (local) | "anthropic" (cloud) | "openai_compat" (Groq/Mistral/Gemini/…).
# If the primary fails, another *configured* cloud provider is tried as fallback.
LLM_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Generic OpenAI-compatible provider (set LLM_PROVIDER=openai_compat). Swap
# vendors by changing only these three — no code change:
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=openai/gpt-oss-120b
#   Mistral: LLM_BASE_URL=https://api.mistral.ai/v1          LLM_MODEL=mistral-small-latest
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Google Gemini key. Gemini is reached through the openai_compat provider above
# (its OpenAI-compatible endpoint); kept as a named var for deploy clarity.
GEMINI_API_KEY=

# ---- Public landing chatbot ----
# Master switch for POST /api/public/chatbot. false => always static fallback,
# so the marketing site keeps working with the AI off. Per-IP rate limited.
PUBLIC_CHATBOT_ENABLED=true
RATE_LIMIT_CHATBOT_PER_MINUTE=20

# ---- Stripe ----
# Leave empty to keep the Free plan working without payment integration.
# When set, Standard and Premium go through Stripe Checkout. The webhook is
# the source of truth for subscription state — always verify the signature.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Create one Stripe Price ID per (plan, billing cycle) in your Stripe dashboard.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Landing-checkout price aliases used by POST /api/billing/create-checkout-session
# (starter→Standard, pro→Business, enterprise→Premium). When empty, the public
# checkout falls back to the *_MONTHLY price IDs above — one set of IDs is enough.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Where Stripe redirects after Checkout success/cancel.
STRIPE_SUCCESS_URL=http://localhost:3030/en/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:3030/en/pricing?stripe=cancel

# ---- Transactional email (ADR-017) ----
# Provider: console (dev default, logs the email) | resend (SaaS) | smtp (self-host).
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@crmgallo.app
EMAIL_FROM_NAME=CRM Gallo
# Origin used to build links in emails (invite / password reset).
FRONTEND_BASE_URL=http://localhost:3030
# Resend (only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# SMTP relay (only when EMAIL_PROVIDER=smtp). STARTTLS on 587 is the
# safe default; for a local catch-all (MailHog) use port 1025 + TLS off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Frontend (NEXT_PUBLIC_* are exposed to the browser bundle) ----
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_DEFAULT_LOCALE=pt
# Optional hosted Stripe Checkout / Payment Link for the landing subscribe CTA.
# When set, the landing redirects straight to it; when empty the CTA calls
# POST /api/billing/create-checkout-session instead.
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Postgres ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
